{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "APP_VARIANT": "release"
      }
    }
  }
}
