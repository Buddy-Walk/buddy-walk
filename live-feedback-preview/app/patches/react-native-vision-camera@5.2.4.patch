+  // Buddy Walk patch: a Frame's orientation says how its pixels are rotated relative to
+  // upright ('left' is -90°), but UIImage.Orientation names the turn that displays them
+  // upright (.right turns the pixels 90° clockwise). Mapping 'left' to .left showed
+  // quarter-turned frames upside down, so the quarter turns are swapped here.
+  private static func displayOrientation(of metadata: MediaSampleMetadata) -> UIImage.Orientation {
+    switch metadata.orientation {
+    case .up, .down:
+      return metadata.uiImageOrientation
+    case .left:
+      return metadata.isMirrored ? .rightMirrored : .right
+    case .right:
+      return metadata.isMirrored ? .leftMirrored : .left
+    }
+  }
