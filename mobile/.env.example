# ─────────────────────────────────────────────────────────────────────
# Mobile client (Expo) — these variables are bundled into the app and
# must be prefixed with EXPO_PUBLIC_ to be exposed to React Native code.
#
# First-time setup: copy this file to .env (git does not include .env):
#   cp .env.example .env        # macOS/Linux
#   copy .env.example .env      # Windows
# Then restart Expo: npx expo start -c
# ─────────────────────────────────────────────────────────────────────
# Skip sign-in for local dev (no Google/Firebase OAuth keys needed on your machine)
EXPO_PUBLIC_BYPASS_AUTH=true

# API URL (optional — defaults to https://buddy-walk-api.onrender.com)
# Legacy buddywalk.app is blocked by the client — all traffic goes to our Render API.
# Do NOT use localhost on a physical phone (localhost is the phone itself).
# Leave unset for production/TestFlight, or use your computer's LAN IP for local server:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Companion API (optional — defaults to the same Render host in buddy-walk-default-api.json)
# Run `npm run serve` in mobile/, then set your PC's LAN or Tailscale IP:
# EXPO_PUBLIC_COMPANION_API_URL=http://100.x.x.x:8000
# Share links automatically use the same host (no extra URL needed on LAN/Tailscale).
# EXPO_PUBLIC_COMPANION_SHARE_URL=https://buddywalk.app

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────
# Backend (mobile/server) — run `npm run serve` locally or deploy to Render.
# These are NOT bundled into the mobile client.
#
# ZERO-CONFIG (Render default): leave API keys blank. The server stores
# telemetry, feedback, chat logs, and companion data in memory and proxies
# AI/speech/MTA to buddywalk.app in the background. Copy ADMIN_TOKEN from
# Render → Environment after deploy for /usage dashboard access.
# ─────────────────────────────────────────────────────────────────────

# HTTP server
PORT=8000
NODE_ENV=development
# Comma-separated list of origins allowed in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://buddy-walk-api.onrender.com

# Admin dashboard (/usage) and CSV exports — set on Render (auto-generated there)
ADMIN_TOKEN=

# Zero-config proxy (optional — auto-enabled when OPENAI_API_KEY is absent)
# UPSTREAM_API_ROOT=https://buddywalk.app
# ZERO_CONFIG=true

# Optional: only needed if you want self-hosted AI instead of proxy mode
WEB_LINK=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MTA_API_KEY=
AZURE_SUBSCRIPTION_KEY=
AZURE_REGION=
DOORFRONT_URI=
TEST=local
