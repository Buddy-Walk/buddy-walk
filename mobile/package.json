  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "tsx src/test/runAll.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.native.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.node.json",
    "qa": "npm run typecheck && npm test",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "serve": "tsx server/index.ts",
    "serve:dev": "nodemon --watch server --ext ts,json --exec \"tsx server/index.ts\"",
    "server-build": "tsc --project tsconfig.node.json"
  },
