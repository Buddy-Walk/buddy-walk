{
  "name": "team-console",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "infisical run --env=dev --path=/team-console -- vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "cf-typegen": "wrangler types",
    "deploy": "vp build && wrangler deploy",
    "stack": "bun scripts/local-stack.ts",
    "e2e": "playwright test",
    "compare": "bun scripts/local-stack.ts bun scripts/compare-with-old-page.ts",
    "compare:prod": "infisical run --env=prod --path=/team-console --silent -- bun scripts/compare-with-old-page.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-query-devtools": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "1.64.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.70.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
