{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddy-walk-team-console",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Values come from Infisical: a Secret Sync in production, `infisical run` locally.
  "secrets": { "required": ["ADMIN_TOKEN", "API_BASE_URL"] },
}
